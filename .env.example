# Local development values. For Vercel, configure HTTPS deployment values in
# the project settings before building; see docs/VERCEL.md. Public variables
# are included in the browser bundle. Keep provider/database secrets on the API.
NEXT_PUBLIC_SITE_URL=http://shario.localhost:4310

# Hostname only. Keep these values aligned and omit protocol, port, and path.
NEXT_PUBLIC_ROOT_DOMAIN=shario.localhost
TENANT_ROOT_DOMAIN=shario.localhost
NEXT_PUBLIC_API_URL=http://api.shario.localhost:4311

# Native invoice management is disabled for the MVP. To restore it, enable
# NATIVE_INVOICES_ENABLED on the API and this flag, then rebuild the client.
NEXT_PUBLIC_NATIVE_INVOICES_ENABLED=false

# Shario enables the same 18 languages as Skab. English and Czech are always
# included; this list adds the other 16. Incomplete product catalogs retain
# English fallback and their existing preview/noindex status.
NEXT_PUBLIC_ENABLED_LOCALES=de,pl,sk,da,fr,es,it,pt-PT,sv,nb,fi,hu,el,tr,nl,ro

# Production requires this switch as well as the list above. It enables the
# language routes; it does not mark incomplete catalogs as fully translated.
NEXT_PUBLIC_ENABLE_PREVIEW_LOCALES=true

# Stable fallback for next-intl date/time rendering. Tenant surfaces can later
# override this with their configured studio time zone.
NEXT_PUBLIC_DEFAULT_TIME_ZONE=Europe/Prague

# Optional routing configuration.
PLATFORM_HOSTNAMES=
CUSTOM_DOMAIN_TENANTS={}
LEGACY_TENANT_SLUGS=
