{
  "name": "shario-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --port 4310",
    "dev:webpack": "next dev --webpack --port 4310",
    "postinstall": "node scripts/apply-headlessui-transition-backport.mjs",
    "prebuild": "node scripts/apply-headlessui-transition-backport.mjs",
    "build": "next build --webpack",
    "prebuild:turbopack": "node scripts/apply-headlessui-transition-backport.mjs",
    "build:turbopack": "next build",
    "build:clean": "npm run clean && npm run build",
    "start": "next start --port 4310",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/validate-locales.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:list": "playwright test --list",
    "test:visual": "playwright test --config=playwright.visual.config.js",
    "test:visual:ui": "playwright test --config=playwright.visual.config.js --ui",
    "test:products": "node --test tests/products.contract.test.mjs",
    "check": "npm run lint && npm run format:check && npm run i18n:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cleanup:customer-shell": "node scripts/cleanup-customer-shell-routes.mjs",
    "clean": "node -e \"require('fs').rmSync('.next',{ recursive: true, force: true })\"",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "test:critical": "vitest run --config vitest.critical.config.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@reduxjs/toolkit": "2.12.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "async-mutex": "0.5.0",
    "clsx": "2.1.1",
    "czech-vocative": "2.1.0",
    "date-fns": "4.4.0",
    "dayjs": "1.11.18",
    "framer-motion": "12.42.2",
    "js-cookie": "3.0.8",
    "jwt-decode": "4.0.0",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "react": "19.2.7",
    "react-datepicker": "9.1.0",
    "react-device-detect": "2.2.3",
    "react-dom": "19.2.7",
    "react-redux": "9.3.0",
    "react-tailwindcss-datepicker": "2.0.0",
    "redux-persist": "6.0.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.16",
    "prettier": "3.9.5",
    "tailwindcss": "4.3.2",
    "vitest": "^4.1.10"
  }
}
